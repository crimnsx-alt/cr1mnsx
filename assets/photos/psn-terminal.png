<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>PSN.GG — Security Check</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; height: 100%; }
        body {
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            background:
                radial-gradient(ellipse at 20% 30%, rgba(232, 51, 77, 0.14) 0%, transparent 50%),
                linear-gradient(135deg, #020617 0%, #0d1a2e 55%, #1a0a1f 100%);
            color: #e2e8f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1.5rem;
            position: relative;
            overflow-x: hidden;
        }
        body::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, #E8334D 30%, #3b9eff 70%, transparent);
            opacity: 0.8;
        }
        body::after {
            content: '';
            position: absolute; inset: 0;
            background-image:
                linear-gradient(rgba(232, 51, 77, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(232, 51, 77, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
            z-index: 0;
        }
        .container { position: relative; z-index: 1; text-align: center; max-width: 560px; }
        .brand { display: inline-flex; align-items: center; gap: 0.9rem; margin-bottom: 2.5rem; text-decoration: none; }
        .brand-icon { width: 56px; height: 56px; filter: drop-shadow(0 0 12px rgba(59, 158, 255, 0.5)); }
        .brand-text {
            font-family: 'Impact', 'Arial Black', 'Helvetica Neue', sans-serif;
            font-size: 2rem; font-weight: 900; letter-spacing: 0.18em; color: #fff; line-height: 1;
        }
        .brand-text .gg { color: #3b9eff; }
        .alert-tag {
            display: inline-block;
            padding: 0.3rem 0.75rem;
            background: rgba(232, 51, 77, 0.15);
            border: 1px solid rgba(232, 51, 77, 0.5);
            border-radius: 999px;
            font-family: 'Courier New', monospace;
            font-size: 0.7rem;
            color: #E8334D;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }
        .stripe {
            display: block; height: 2px; width: 120px; margin: 0 auto 1.5rem;
            background: linear-gradient(90deg, transparent, #E8334D 30%, #3b9eff 70%, transparent);
        }
        h1 {
            font-family: 'Impact', 'Arial Black', sans-serif;
            font-size: clamp(1.5rem, 4vw, 2.25rem);
            font-weight: 700; color: #fff; text-transform: uppercase;
            letter-spacing: 0.12em; margin: 0 0 1rem;
        }
        .message { color: #cbd5e1; font-size: 1rem; line-height: 1.6; margin: 0 auto 2rem; max-width: 480px; }
        .cf-box {
            margin: 0 auto 2.5rem;
            padding: 1.5rem;
            background: rgba(2, 6, 23, 0.6);
            border: 1px solid rgba(59, 158, 255, 0.3);
            border-radius: 10px;
            min-height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .pulse {
            display: inline-block;
            width: 12px; height: 12px;
            margin-right: 0.5rem;
            border-radius: 50%;
            background: #E8334D;
            box-shadow: 0 0 12px rgba(232, 51, 77, 0.8);
            animation: pulse 1.5s ease-in-out infinite;
            vertical-align: middle;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.85); }
        }
        .hint {
            font-family: 'Courier New', monospace;
            font-size: 0.75rem;
            color: #94a3b8;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            margin-bottom: 3rem;
        }
        .footer {
            font-family: 'Courier New', monospace; font-size: 0.7rem;
            color: #475569; letter-spacing: 0.25em; text-transform: uppercase;
        }
        .footer .x { color: #5A4DD9; }
        .footer .o { color: #E8334D; }
        .footer .t { color: #0AB5A3; }
        .footer .s { color: #E5479C; }
    </style>
<meta http-equiv="refresh" content="360"></head>
<body>
    <div class="container">
        <a href="https://psn.gg/" class="brand">
            <svg class="brand-icon" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M 0 96 L 96 0 L 512 0 L 512 416 L 416 512 L 0 512 Z" fill="#02040A" stroke="#3B9EFF" stroke-width="22"/>
                <g stroke="#5A4DD9" stroke-width="30" stroke-linecap="round" fill="none">
                    <line x1="100" y1="120" x2="220" y2="240"/>
                    <line x1="220" y1="120" x2="100" y2="240"/>
                </g>
                <circle cx="372" cy="180" r="62" stroke="#E8334D" stroke-width="30" fill="none"/>
                <polygon points="160,288 230,412 90,412" stroke="#0AB5A3" stroke-width="30" fill="none" stroke-linejoin="round"/>
                <rect x="306" y="290" width="124" height="124" stroke="#E5479C" stroke-width="30" fill="none"/>
            </svg>
            <span class="brand-text">PSN<span class="gg">.GG</span></span>
        </a>

        <div class="alert-tag">Heightened Security</div>

        <span class="stripe"></span>

        <div class="hint">
            <span class="pulse"></span> Running browser integrity checks&hellip;
        </div>

